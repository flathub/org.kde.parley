{
    "app-id": "org.kde.parley",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.10",
    "base": "io.qt.qtwebengine.BaseApp",
    "base-version": "6.10",
    "sdk": "org.kde.Sdk",
    "command": "parley",
    "rename-icon": "parley",
    "finish-args": [
        "--device=dri",
        "--share=ipc",
        "--share=network",
        "--socket=fallback-x11",
        "--socket=wayland"
    ],
    "cleanup": [
        "/include",
        "/mkspecs",
        "/share/doc"
    ],
    "cleanup-commands": [
        "/app/cleanup-BaseApp.sh"
    ],
    "modules": [
        {
            "name": "libkeduvocdocument",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DBUILD_TESTING=OFF",
                "-DQT_MAJOR_VERSION=6"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/release-service/26.08.0/src/libkeduvocdocument-26.08.0.tar.xz",
                    "sha256": "a2a62ee5be1d6aae3180dcbebf311475a8e7b8eb46ac058f4df1a27828d58a09",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 8763,
                        "stable-only": true,
                        "url-template": "https://download.kde.org/stable/release-service/$version/src/libkeduvocdocument-$version.tar.xz"
                    }
                }
            ]
        },
        {
            "name": "parley",
            "buildsystem": "cmake-ninja",
            "post-install": [
                "mkdir $FLATPAK_DEST/share/licenses/$FLATPAK_ID/parley/",
                "cp -rv LICENSES/* $FLATPAK_DEST/share/licenses/$FLATPAK_ID/parley/"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/release-service/26.08.0/src/parley-26.08.0.tar.xz",
                    "sha256": "d1c3b7a3096181e669c60ad98b7b35d08cd16a9bbc7424781e47da78cafb0f62",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 8763,
                        "stable-only": true,
                        "url-template": "https://download.kde.org/stable/release-service/$version/src/parley-$version.tar.xz"
                    }
                }
            ]
        }
    ]
}
