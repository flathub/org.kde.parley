{
    "app-id": "org.kde.parley",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.10",
    "base": "io.qt.qtwebengine.BaseApp",
    "base-version": "6.10",
    "sdk": "org.kde.Sdk",
    "command": "parley",
    "rename-icon": "parley",
    "finish-args": [
        "--device=dri",
        "--share=ipc",
        "--share=network",
        "--socket=fallback-x11",
        "--socket=wayland"
    ],
    "cleanup": [
        "/include",
        "/mkspecs",
        "/share/doc"
    ],
    "cleanup-commands": [
        "/app/cleanup-BaseApp.sh"
    ],
    "modules": [
        {
            "name": "libkeduvocdocument",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DBUILD_TESTING=OFF",
                "-DQT_MAJOR_VERSION=6"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/release-service/26.08.2/src/libkeduvocdocument-26.08.2.tar.xz",
                    "sha256": "fc948c804eccab19d418afafd2549dd99a0ec2ddcaca7b71025fc3ba3b773495",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 8763,
                        "stable-only": true,
                        "url-template": "https://download.kde.org/stable/release-service/$version/src/libkeduvocdocument-$version.tar.xz"
                    }
                }
            ]
        },
        {
            "name": "parley",
            "buildsystem": "cmake-ninja",
            "post-install": [
                "mkdir $FLATPAK_DEST/share/licenses/$FLATPAK_ID/parley/",
                "cp -rv LICENSES/* $FLATPAK_DEST/share/licenses/$FLATPAK_ID/parley/"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/release-service/26.08.2/src/parley-26.08.2.tar.xz",
                    "sha256": "e60f02e6d253e01ef4ec773f35ba27251975e00d20dbd95e9809a1d01fe8416e",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 8763,
                        "stable-only": true,
                        "url-template": "https://download.kde.org/stable/release-service/$version/src/parley-$version.tar.xz"
                    }
                }
            ]
        }
    ]
}
