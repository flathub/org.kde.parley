{
    "app-id": "org.kde.parley",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.10",
    "base": "io.qt.qtwebengine.BaseApp",
    "base-version": "6.10",
    "sdk": "org.kde.Sdk",
    "command": "parley",
    "rename-icon": "parley",
    "finish-args": [
        "--device=dri",
        "--share=ipc",
        "--share=network",
        "--socket=fallback-x11",
        "--socket=wayland"
    ],
    "cleanup": [
        "/include",
        "/mkspecs",
        "/share/doc"
    ],
    "cleanup-commands": [
        "/app/cleanup-BaseApp.sh"
    ],
    "modules": [
        {
            "name": "libkeduvocdocument",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DBUILD_TESTING=OFF",
                "-DQT_MAJOR_VERSION=6"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/release-service/26.04.2/src/libkeduvocdocument-26.04.2.tar.xz",
                    "sha256": "da1fa33f918a177e60bf51fa589748d8ff42fc230a7ab0d555d0eb8a01c09ff7",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 8763,
                        "stable-only": true,
                        "url-template": "https://download.kde.org/stable/release-service/$version/src/libkeduvocdocument-$version.tar.xz"
                    }
                }
            ]
        },
        {
            "name": "parley",
            "buildsystem": "cmake-ninja",
            "post-install": [
                "mkdir $FLATPAK_DEST/share/licenses/$FLATPAK_ID/parley/",
                "cp -rv LICENSES/* $FLATPAK_DEST/share/licenses/$FLATPAK_ID/parley/"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/release-service/26.04.2/src/parley-26.04.2.tar.xz",
                    "sha256": "1207690ca4aaf5cc7fe299b12173a3d2eeeb558826b81544da5280472fdd00fc",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 8763,
                        "stable-only": true,
                        "url-template": "https://download.kde.org/stable/release-service/$version/src/parley-$version.tar.xz"
                    }
                }
            ]
        }
    ]
}
